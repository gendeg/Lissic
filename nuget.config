<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <packageSources>
    <clear />
    <add key="LocalPackages" value="./Tests/PackageTests/Packages" />
    <add key="NuGetOrg" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="LocalPackages">
      <package pattern="Lissic*" />
    </packageSource>
    <packageSource key="NuGetOrg">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>