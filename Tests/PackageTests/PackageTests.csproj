<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <MSBuildMultiTargetingUtilizeCache>false</MSBuildMultiTargetingUtilizeCache>

    <LissicTemplateRoot>TestTemplates</LissicTemplateRoot>
    <LissicTemplateSourceRoot>../Templates/TestTemplates</LissicTemplateSourceRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lissic" Version="*" />
    <!-- This ensures the latest Lissic code is built before the test is run -->
    <ProjectReference Include="../../src/Lissic/Lissic.csproj" 
                      ReferenceOutputAssembly="false" 
                      SkipGetTargetFrameworkProperties="true" />

    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <Target Name="ClearLocalNugetCache" BeforeTargets="Restore">
    <ItemGroup>
      <CacheFiles Include="$(NugetPackageRoot)Lissic/**/*.*" />
    </ItemGroup>
    <Delete Files="@(CacheFiles)" />
    <RemoveDir Directories="$(NugetPackageRoot)Lissic/" Condition="Exists('$(NugetPackageRoot)Lissic/')" />
  </Target>

</Project>
