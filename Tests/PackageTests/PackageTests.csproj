<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <MSBuildMultiTargetingUtilizeCache>false</MSBuildMultiTargetingUtilizeCache>

    <LissicTemplateRoot>TestTemplates</LissicTemplateRoot>
    <LissicTemplateSourceRoot>../Templates/TestTemplates</LissicTemplateSourceRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lissic" Version="*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="../Templates/header.html" />
  </ItemGroup>

  <!-- Create full-path template for tests based on project directory -->
  <Target Name="GenerateFullPathTemplate" BeforeTargets="BeforeCompile;CoreCompile">
    <PropertyGroup>
      <_FullPathTemplateFile>$(IntermediateOutputPath)FullPathTemplate.g.cs</_FullPathTemplateFile>
      <_FullPathTemplateSource>
namespace Lissic.Package.Tests%3B

public partial class ImportedPackageTests
{
    [TemplatePath(@"$(MSBuildProjectDirectory)/TestTemplates/test.html")]
    public partial class TestFullPathTemplate {}
}
      </_FullPathTemplateSource>
    </PropertyGroup>
    <WriteLinesToFile File="$(_FullPathTemplateFile)" Lines="$(_FullPathTemplateSource)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Remove="$(_FullPathTemplateFile)" />
      <Compile Include="$(_FullPathTemplateFile)" />
    </ItemGroup>
  </Target>

  <!-- Ensure latest version of Lissic is packed before restore -->
  <Target Name="PackLissic" BeforeTargets="Restore;ClearLocalNuGetCache" Condition="'$(BuildingSolutionFile)' != 'true'">
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)../../src/LissicGen/LissicGen.csproj&quot; -c $(Configuration)" />
    <Exec Command="dotnet pack &quot;$(MSBuildThisFileDirectory)../../src/Lissic/Lissic.csproj&quot; -c $(Configuration) -o &quot;$(MSBuildThisFileDirectory)Packages&quot;" />
  </Target>

  <Target Name="ClearLocalNuGetCache" BeforeTargets="Restore">
    <ItemGroup>
      <CacheFiles Include="$(NugetPackageRoot)Lissic/**/*.*" />
    </ItemGroup>
    <Delete Files="@(CacheFiles)" />
    <RemoveDir Directories="$(NugetPackageRoot)Lissic/" Condition="Exists('$(NugetPackageRoot)Lissic/')" />
  </Target>

</Project>
