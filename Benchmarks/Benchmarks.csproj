<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultRazorSlices>false</EnableDefaultRazorSlices>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotLiquid" Version="2.3.260" />
    <PackageReference Include="Scriban" Version="7.5.3" />
    <PackageReference Include="Handlebars.Net" Version="2.4.3" />
    <PackageReference Include="Fluid.Core" Version="3.0.0-beta.8" />
    <PackageReference Include="RazorSlices" Version="0.12.2" />
    <PackageReference Include="Lissic" Version="0.1.4" PrivateAssets="all" />
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Microsoft.VisualStudio.DiagnosticsHub.BenchmarkDotNetDiagnosers" Version="18.12.37802.2" />
  </ItemGroup>

  <ItemGroup>
    <RazorSlice Include="Slices\*.cshtml" />
  </ItemGroup>

</Project>
